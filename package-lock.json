{
  "name": "grill-me-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "grill-me-workspace",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@grill-me/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@grill-me/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@grill-me/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/grill-me-ai": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/qrcode-generator": {
      "version": "1.5.2",
      "resolved": "https://registry.npmjs.org/qrcode-generator/-/qrcode-generator-1.5.2.tgz",
      "integrity": "sha512-pItrW0Z9HnDBnFmgiNrY1uxRdri32Uh9EjNYLPVC2zZ3ZRIIEqBoDgm4DkvDwNNDHTK7FNkmr8zAa77BYc9xNw==",
      "license": "MIT"
    },
    "packages/cli": {
      "name": "grill-me-ai",
      "version": "0.2.0",
      "license": "MIT",
      "dependencies": {
        "qrcode-generator": "^1.4.4"
      },
      "bin": {
        "grill-me": "bin/grill-me.js"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/core": {
      "name": "@grill-me/core",
      "version": "0.0.0"
    },
    "packages/server": {
      "name": "@grill-me/server",
      "version": "0.2.0"
    },
    "packages/ui": {
      "name": "@grill-me/ui"
    }
  }
}
