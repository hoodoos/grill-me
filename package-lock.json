{
  "name": "grill-me-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "grill-me-workspace",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@grill-me/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/core": {
      "name": "@grill-me/core",
      "version": "0.0.0"
    }
  }
}
